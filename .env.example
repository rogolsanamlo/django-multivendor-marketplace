# Copy to .env and fill in. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Database: "mysql" (default) or "sqlite" for a quick local demo
DB_ENGINE=mysql
DB_NAME=dbbazarak
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Payment gateway (ZarinPal). In sandbox mode any 36-character id works; production needs a real one.
ZARINPAL_MERCHANT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
ZARINPAL_SANDBOX=True
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_CALLBACK_URL=http://127.0.0.1:8000/payments/verify/

# SMS (Kavenegar). Leave empty to print verification codes to the console.
KAVENEGAR_API_KEY=
